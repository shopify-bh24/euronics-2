{% assign hot_collection = collections['black-friday-hot-offers'] %}
{% assign picks_collection = collections['black-friday-picks'] %}
{% assign low_collection = collections['black-friday-super-low'] %}
{% assign mailer_url = page.metafields.custom.mailer_url.value | default: 'https://euronics.ie/mailer/black-friday-2025.pdf#toolbar=0' %}

<style>
  :root {
    --black:#0A0A0A;
    --offblack:#111111;
    --card:#1A1A1A;
    --border:#222222;
    --gold:#FECF2F;
    --blue:#005EB8;
    --blue-dk:#004b91;
    --text:#F5F5F5;
    --muted:#9CA3AF;
  }

  .bf-page *{box-sizing:border-box}
  .bf-page{
    font-family:system-ui,-apple-system,Roboto,Helvetica,Arial,sans-serif;
    background:var(--black);
    background-image:repeating-linear-gradient(45deg,rgba(255,255,255,0.03)0,rgba(255,255,255,0.03)1px,transparent1px,transparent20px);
    color:var(--text);line-height:1.5
  }
  .bf-container{max-width:1200px;margin:0 auto;padding:0 1.25rem}
  h1,h2{margin-bottom:.5rem;font-weight:800;letter-spacing:-.02em}
  h1{font-size:clamp(2.5rem,4vw,4.25rem);color:var(--gold);text-align:center}
  h2{font-size:clamp(1.5rem,2.2vw,2rem);color:var(--gold)}
  .section{padding:4rem 0}
  .tone-1{background:var(--black)}
  .tone-2{background:var(--offblack)}
  .tone-3{background:var(--card)}

  /* ===== Buttons ===== */
  .bf-page a.btn,
  .bf-page button.btn{
    display:inline-block!important;
    border:none!important;
    border-radius:16px!important;
    padding:1rem 1.8rem!important;
    font-weight:700!important;
    font-size:1rem!important;
    text-transform:uppercase!important;
    text-decoration:none!important;
    letter-spacing:.5px!important;
    cursor:pointer!important;
    transition:all .25s ease-in-out!important;
    text-align:center!important;
    position:relative;overflow:hidden
  }

  /* Hero CTA */
  .bf-page .btn.hero-cta{
    background:linear-gradient(90deg,var(--gold),#ffd84f)!important;
    color:var(--black)!important;
    font-size:1.4rem!important;
    padding:1.3rem 3rem!important;
    border-radius:20px!important;
    box-shadow:0 0 20px rgba(254,207,47,.4),0 0 60px rgba(254,207,47,.2)!important
  }
  .bf-page .btn.hero-cta:hover{
    background:#ffd84f!important;
    box-shadow:0 0 30px rgba(254,207,47,.6),0 0 80px rgba(254,207,47,.3)!important;
    transform:translateY(-2px)!important
  }

  /* Price button */
  .price-btn{
    display:flex!important;
    align-items:center;
    justify-content:center;
    gap:.6rem;
    background:linear-gradient(90deg,var(--gold),var(--blue));
    color:var(--black)!important;
    font-weight:800!important;
    font-size:1.05rem!important;
    padding:1rem 1.5rem!important;
    border-radius:14px!important;
    box-shadow:0 0 16px rgba(254,207,47,.3);
    transition:all .3s ease-in-out;
  }
  .price-btn:hover{
    transform:scale(1.05);
    box-shadow:0 0 25px rgba(254,207,47,.6);
  }
  .price-btn .price-now{
    background:var(--black);
    color:var(--gold);
    border-radius:8px;
    padding:.25rem .5rem;
    font-weight:700;
  }
  .price-btn .label{
    color:#fff;
    text-transform:uppercase;
    letter-spacing:.5px;
    font-weight:700;
  }

  /* ===== Grid & Cards ===== */
  .grid{display:grid;gap:1.25rem}
  .grid-3{grid-template-columns:repeat(3,1fr)}
  .grid-4{grid-template-columns:repeat(4,1fr)}
  @media(max-width:1024px){.grid-3,.grid-4{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:640px){.grid-3,.grid-4{grid-template-columns:1fr}}

  .card{background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden;transition:transform .2s}
  .card:hover{transform:translateY(-2px)}

  .pimg-wrap{width:100%;aspect-ratio:4/3;background:#0f0f0f;display:flex;align-items:center;justify-content:center;overflow:hidden}
  .pimg{max-width:100%;max-height:100%;object-fit:contain;width:auto;height:auto;display:block}
  @media(max-width:480px){.pimg-wrap{aspect-ratio:1/1}}

  .ptitle{font-weight:700;margin:.6rem 0 .1rem}
  .vendor{color:var(--muted);font-size:.9rem;margin-bottom:.35rem}
  .price{display:flex;gap:.6rem;align-items:baseline;flex-wrap:wrap}
  .price-was{color:#64748b;text-decoration:line-through;font-size:.9rem}
  .price-save{color:#cbd5e1;font-size:.9rem}

  .trust{display:flex;flex-wrap:wrap;gap:1rem;justify-content:center;color:#cbd5e1;list-style:none}
  .urgency{text-align:center;color:var(--gold);font-size:1.125rem}
  .mailer-frame{width:100%;height:600px;border:1px solid #333;border-radius:14px;box-shadow:0 10px 30px rgba(0,0,0,.35)}
  .countdown{text-align:center;margin-top:1rem}
  .countdown-box{display:inline-block;background:var(--card);border:1px solid var(--border);padding:1rem 1.5rem;border-radius:14px}
  .countdown-time{font-family:ui-monospace;font-weight:800;color:var(--gold);font-size:clamp(1.6rem,3vw,2.25rem);letter-spacing:.25ch}
  .countdown-sub{color:#94a3b8;font-size:.9rem}
</style>

<div class="bf-page">
  <!-- HERO -->
  <section class="section tone-1 hero">
    <div class="bf-container">
      <h1>Black Friday Deals 2025</h1>
      <p style="text-align:center;color:#cbd5e1;">Massive discounts across tech, appliances & more. Limited time only.</p>
      <div class="countdown">
        <div class="countdown-box">
          <div id="bf-countdown" class="countdown-time">Loading…</div>
          <div id="bf-countdown-sub" class="countdown-sub">until deals go live</div>
        </div>
      </div>
      <div style="text-align:center;margin-top:1.5rem;">
        <a href="/collections/black-friday" class="btn hero-cta">Shop All Deals</a>
      </div>
    </div>
  </section>

  {% comment %} === PRODUCT SECTIONS === {% endcomment %}
  {% for section in (1..3) %}
    {% case section %}
      {% when 1 %}
        {% assign collection = hot_collection %}
        {% assign title = '🔥 Hot Offers' %}
        {% assign tone = 'tone-1' %}
      {% when 2 %}
        {% assign collection = picks_collection %}
        {% assign title = 'Top Black Friday Picks' %}
        {% assign tone = 'tone-2' %}
      {% when 3 %}
        {% assign collection = low_collection %}
        {% assign title = 'Super Low Deals' %}
        {% assign tone = 'tone-1' %}
    {% endcase %}

  <section class="section {{ tone }}">
    <div class="bf-container">
      <h2>{{ title }}</h2>
      <div class="{% if section == 2 %}carousel{% elsif section == 3 %}grid grid-4{% else %}grid grid-3{% endif %}">
        {% for product in collection.products limit:8 %}
          {% assign has_compare = false %}
          {% assign save_amt = 0 %}
          {% if product.compare_at_price and product.compare_at_price > product.price %}
            {% assign diff = product.compare_at_price | minus: product.price %}
            {% if diff > 0 %}
              {% assign has_compare = true %}
              {% assign save_amt = diff %}
            {% endif %}
          {% endif %}

          <article class="card">
            <div class="pimg-wrap">
              {% if product.featured_image %}
                <img class="pimg" src="{{ product.featured_image | img_url: '800x' }}" alt="{{ product.featured_image.alt | escape }}">
              {% endif %}
            </div>
            <div style="padding:1rem">
              <div class="ptitle">{{ product.title }}</div>
              <div class="vendor">by {{ product.vendor }}</div>

              {% if has_compare %}
                <div class="price">
                  <span class="price-was">{{ product.compare_at_price | money }}</span>
                  <span class="price-save">Save {{ save_amt | money }}</span>
                </div>
              {% endif %}

              <a class="btn price-btn" href="{{ product.url }}">
                <span class="price-now">{{ product.price | money }}</span>
                <span class="label">Shop Now</span>
              </a>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endfor %}

  <!-- MAILER -->
  <section class="section tone-3" style="text-align:center;">
    <div class="bf-container">
      <h2>✉️ See Our Black Friday Mailer</h2>
      <p>Browse our official Black Friday leaflet digitally — packed with this year’s biggest savings, before it lands in your letterbox.</p>
      <iframe class="mailer-frame" src="{{ mailer_url }}" title="Black Friday Mailer"></iframe>
      <div style="margin-top:1.5rem;">
        <a class="btn price-btn" href="{{ mailer_url }}" target="_blank" rel="noopener">
          <span class="price-now">View</span><span class="label">Full Mailer</span>
        </a>
      </div>
    </div>
  </section>

  <!-- TRUST + URGENCY -->
  <section class="section tone-3" style="padding-top:2rem;padding-bottom:2rem;">
    <div class="bf-container">
      <ul class="trust">
        <li>🚚 Free Delivery over €50</li>
        <li>🏬 Click & Collect</li>
        <li>🇮🇪 Irish-Owned</li>
        <li>💫 Price Match Promise</li>
      </ul>
    </div>
  </section>
  <section class="section tone-1" style="padding-top:1rem;padding-bottom:3rem;">
    <div class="bf-container">
      <p class="urgency">⚡ Deals are going fast — grab yours before they’re gone!</p>
    </div>
  </section>
</div>

<script>
(function(){
  const el=document.getElementById('bf-countdown');
  const sub=document.getElementById('bf-countdown-sub');
  if(!el)return;
  const target=new Date('2025-11-28T00:00:00Z').getTime();
  function tick(){
    const diff=Math.max(0,target-Date.now());
    const d=Math.floor(diff/86400000),
          h=Math.floor((diff/3600000)%24),
          m=Math.floor((diff/60000)%60),
          s=Math.floor((diff/1000)%60);
    if(diff<=0){el.textContent='LIVE NOW';if(sub){sub.textContent='Shop Black Friday Deals Now'};return;}
    el.textContent=`${d}d ${h}h ${m}m ${s}s`;
  }
  tick();setInterval(tick,1000);
})();
</script>





