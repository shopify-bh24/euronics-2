{% assign hot_collection = collections['black-friday-hot-offers'] %}
{% assign picks_collection = collections['black-friday-picks'] %}
{% assign low_collection = collections['black-friday-super-low'] %}
{% assign mailer_url = page.metafields.custom.mailer_url.value | default: 'https://euronics.ie/mailer/black-friday-2025.pdf#toolbar=0' %}

<style>
  :root {
    --black:#0A0A0A;
    --offblack:#111111;
    --card:#1A1A1A;
    --border:#222222;
    --gold:#FECF2F;
    --blue:#005EB8;
    --blue-dk:#004b91;
    --text:#F5F5F5;
    --muted:#9CA3AF;
  }

  .bf-page * { box-sizing: border-box; }
  .bf-page {
    font-family: system-ui, -apple-system, Roboto, Helvetica, Arial, sans-serif;
    background-color: var(--black);
    background-image:
      repeating-linear-gradient(
        45deg,
        rgba(255, 255, 255, 0.06) 0,
        rgba(255, 255, 255, 0.06) 1px,
        transparent 1px,
        transparent 20px
      );
    background-attachment: fixed;
    background-size: cover;
    color: var(--text);
    line-height: 1.5;
  }

  .bf-container { max-width: 1200px; margin: 0 auto; padding: 0 1.25rem; }
  h1,h2 { margin-bottom: .5rem; font-weight: 800; letter-spacing: -.02em; }
  h1 { font-size: clamp(2.5rem, 4vw, 4.25rem); color: var(--gold); text-align: center; }
  h2 { font-size: clamp(1.5rem, 2.2vw, 2rem); color: var(--gold); text-align:center; }
  .section { padding: 4rem 0; }
  .tone-1 { background: var(--black); }
  .tone-2 { background: var(--offblack); }
  .tone-3 { background: var(--card); }

  /* ===== Buttons ===== */
  .price-btn {
    display: flex !important;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;
    background: linear-gradient(90deg, var(--gold), var(--blue));
    color: var(--black) !important;
    font-weight: 900 !important;
    font-size: 1.2rem !important;
    text-transform: uppercase;
    padding: 1.1rem 2.5rem !important;
    border-radius: 16px !important;
    box-shadow: 0 0 20px rgba(254,207,47,0.4);
    transition: all 0.3s ease-in-out;
    margin: 1rem auto 0 auto;
    text-align: center;
    width: fit-content;
  }
  .price-btn:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 0 30px rgba(254,207,47,0.6);
  }
  .price-btn .price-now {
    background: var(--black);
    color: var(--gold);
    border-radius: 10px;
    padding: 0.3rem 0.7rem;
    font-weight: 800;
    font-size: 1.25rem;
  }
  .price-btn .label {
    color: #fff;
    font-weight: 800;
    letter-spacing: .5px;
  }

  /* Hero CTA */
  .bf-page .btn.hero-cta {
    background: linear-gradient(90deg, var(--gold), #ffd84f) !important;
    color: var(--black) !important;
    font-size: 1.5rem !important;
    padding: 1.3rem 3.5rem !important;
    border-radius: 24px !important;
    box-shadow: 0 0 20px rgba(254,207,47,.4), 0 0 60px rgba(254,207,47,.2) !important;
    font-weight: 900 !important;
  }

  /* ===== Grid & Cards ===== */
  .grid { display: grid; gap: 1.25rem; }
  .grid-3 { grid-template-columns: repeat(3, 1fr); }
  .grid-4 { grid-template-columns: repeat(4, 1fr); }
  @media(max-width:1024px){ .grid-3, .grid-4 { grid-template-columns: repeat(2, 1fr); } }
  @media(max-width:640px){ .grid-3, .grid-4 { grid-template-columns: 1fr; } }

  .card { background: var(--card); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; transition: transform .2s; }
  .card:hover { transform: translateY(-2px); }

  /* Image fix */
  .pimg-wrap { width: 100%; aspect-ratio: 4 / 3; background: #0f0f0f; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .pimg { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }
  @media(max-width:480px){ .pimg-wrap { aspect-ratio: 1 / 1; } }

  .ptitle { font-weight: 700; margin: .6rem 0 .2rem; text-align: center; }
  .vendor { color: var(--muted); font-size: .9rem; margin-bottom: .35rem; text-align: center; }
  .price { display: flex; justify-content: center; gap: .6rem; flex-wrap: wrap; align-items: baseline; margin-top: .5rem; }
  .price-was { color: #64748b; text-decoration: line-through; font-size: .95rem; }
  .price-save { color: #cbd5e1; font-size: .95rem; }

  /* Carousel */
  .carousel { display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: .5rem; }
  .carousel > * { scroll-snap-align: start; flex: 0 0 320px; }

  /* Category Circles */
  .category-circles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 2rem;
    justify-items: center;
    text-align: center;
    margin-top: 2rem;
  }
  .circle {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at top, var(--offblack), var(--black));
    border: 2px solid var(--gold);
    border-radius: 50%;
    width: 130px;
    height: 130px;
    text-decoration: none;
    box-shadow: 0 0 15px rgba(254,207,47,0.15);
    transition: all 0.3s ease;
  }
  .circle:hover { transform: translateY(-5px); box-shadow: 0 0 25px rgba(254,207,47,0.4); }
  .circle-img { width: 60px; height: 60px; object-fit: contain; margin-bottom: 0.5rem; filter: brightness(0.9) contrast(1.2); transition: transform 0.3s ease; }
  .circle:hover .circle-img { transform: scale(1.08); }
  .circle-label { color: var(--gold); font-weight: 700; font-size: 0.9rem; text-align: center; line-height: 1.2; max-width: 90%; }
  @media(max-width:480px){
    .circle { width: 100px; height: 100px; }
    .circle-img { width: 45px; height: 45px; }
    .circle-label { font-size: 0.75rem; }
  }

  /* Misc */
  .trust { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; color: #cbd5e1; list-style: none; }
  .urgency { text-align: center; color: var(--gold); font-size: 1.25rem; font-weight: 700; }
  .mailer-frame { width: 100%; height: 600px; border: 1px solid #333; border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,.35); }
</style>

<div class="bf-page">
  <!-- HERO -->
  <section class="section tone-1 hero">
    <div class="bf-container">
      <h1>Black Friday Deals 2025</h1>
      <p style="text-align:center;color:#cbd5e1;">Massive discounts across tech, appliances & more. Limited time only.</p>
      <div style="text-align:center;margin-top:1.5rem;">
        <a href="/collections/black-friday" class="btn hero-cta">Shop All Deals</a>
      </div>
    </div>
  </section>

  <!-- CATEGORY CIRCLES -->
  <section class="section tone-1" style="padding-top:2rem;">
    <div class="bf-container">
      <h2>Black Friday Offers On</h2>
      <div class="category-circles">
        {% assign categories = 
          "TV & Audio|/collections/black-friday-tv-audio|https://via.placeholder.com/60x60?text=TV,
           Tech|/collections/black-friday-tech|https://via.placeholder.com/60x60?text=Tech,
           Coffee Machines|/collections/black-friday-coffee-machines|https://via.placeholder.com/60x60?text=Coffee,
           Laundry|/collections/black-friday-laundry|https://via.placeholder.com/60x60?text=Laundry,
           Cooking|/collections/black-friday-cooking|https://via.placeholder.com/60x60?text=Cook,
           Kitchen Appliances|/collections/black-friday-kitchen-appliances|https://via.placeholder.com/60x60?text=Kitchen,
           Floorcare|/collections/black-friday-floorcare|https://via.placeholder.com/60x60?text=Floor,
           Dishwashers & Refrigeration|/collections/black-friday-dishwashers-refrigeration|https://via.placeholder.com/60x60?text=Fridge" | split: "," %}
        {% for item in categories %}
          {% assign parts = item | split: "|" %}
          <a href="{{ parts[1] | strip }}" class="circle">
            <img src="{{ parts[2] | strip }}" alt="{{ parts[0] | strip }}" class="circle-img" loading="lazy">
            <div class="circle-label">{{ parts[0] | strip }}</div>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- HOT OFFERS -->
  {% assign collection = hot_collection %}
  <section class="section tone-1">
    <div class="bf-container">
      <h2>🔥 Hot Offers</h2>
      <div class="grid grid-3">
        {% for product in collection.products limit:6 %}
          {% assign has_compare = false %}
          {% assign save_amt = 0 %}
          {% if product.compare_at_price and product.compare_at_price > product.price %}
            {% assign diff = product.compare_at_price | minus: product.price %}
            {% if diff > 0 %}
              {% assign has_compare = true %}
              {% assign save_amt = diff %}
            {% endif %}
          {% endif %}

          <article class="card">
            <div class="pimg-wrap">
              {% if product.featured_image %}
                <img class="pimg" src="{{ product.featured_image | img_url: '800x' }}" alt="{{ product.featured_image.alt | escape }}">
              {% endif %}
            </div>
            <div style="padding:1rem">
              <div class="ptitle">{{ product.title }}</div>
              <div class="vendor">by {{ product.vendor }}</div>
              {% if has_compare %}
                <div class="price">
                  <span class="price-was">{{ product.compare_at_price | money }}</span>
                  <span class="price-save">Save {{ save_amt | money }}</span>
                </div>
              {% endif %}
              <a class="price-btn" href="{{ product.url }}">
                <span class="price-now">{{ product.price | money }}</span>
                <span class="label">Shop Now</span>
              </a>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- TOP PICKS -->
  <section class="section tone-2">
    <div class="bf-container">
      <h2>Top Black Friday Picks</h2>
      <div class="carousel">
        {% for product in picks_collection.products limit:6 %}
          {% assign has_compare = false %}
          {% assign save_amt = 0 %}
          {% if product.compare_at_price and product.compare_at_price > product.price %}
            {% assign diff = product.compare_at_price | minus: product.price %}
            {% if diff > 0 %}
              {% assign has_compare = true %}
              {% assign save_amt = diff %}
            {% endif %}
          {% endif %}

          <article class="card">
            <div class="pimg-wrap">
              {% if product.featured_image %}
                <img class="pimg" src="{{ product.featured_image | img_url: '800x' }}" alt="{{ product.featured_image.alt | escape }}">
              {% endif %}
            </div>
            <div style="padding:1rem">
              <div class="ptitle">{{ product.title }}</div>
              <div class="vendor">by {{ product.vendor }}</div>
              {% if has_compare %}
                <div class="price">
                  <span class="price-was">{{ product.compare_at_price | money }}</span>
                  <span class="price-save">Save {{ save_amt | money }}</span>
                </div>
              {% endif %}
              <a class="price-btn" href="{{ product.url }}">
                <span class="price-now">{{ product.price | money }}</span>
                <span class="label">Shop Now</span>
              </a>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- SUPER LOW DEALS -->
  <section class="section tone-1">
    <div class="bf-container">
      <h2>Super Low Deals</h2>
      <div class="grid grid-4">
        {% for product in low_collection.products limit:8 %}
          {% assign has_compare = false %}
          {% assign save_amt = 0 %}
          {% if product.compare_at_price and product.compare_at_price > product.price %}
            {% assign diff = product.compare_at_price | minus: product.price %}
            {% if diff > 0 %}
              {% assign has_compare = true %}
              {% assign save_amt = diff %}
            {% endif %}
          {% endif %}

          <article class="card">
            <div class="pimg-wrap">
              {% if product.featured_image %}
                <img class="pimg" src="{{ product.featured_image | img_url: '800x' }}" alt="{{ product.featured_image.alt | escape }}">
              {% endif %}
            </div>
            <div style="padding:1rem">
              <div class="ptitle">{{ product.title }}</div>
              <div class="vendor">by {{ product.vendor }}</div>
              {% if has_compare %}
                <div class="price">
                  <span class="price-was">{{ product.compare_at_price | money }}</span>
                  <span class="price-save">Save {{ save_amt | money }}</span>
                </div>
              {% endif %}
              <a class="price-btn" href="{{ product.url }}">
                <span class="price-now">{{ product.price | money }}</span>
                <span class="label">Shop Now</span>
              </a>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- MAILER -->
  <section class="section tone-3" style="text-align:center;">
    <div class="bf-container">
      <h2>✉️ See Our Black Friday Mailer</h2>
      <p>Browse our official Black Friday leaflet digitally — packed with this year’s biggest savings, before it lands in your letterbox.</p>
      <iframe class="mailer-frame" src="{{ mailer_url }}" title="Black Friday Mailer"></iframe>
      <div style="margin-top:1.5rem;">
        <a class="price-btn" href="{{ mailer_url }}" target="_blank" rel="noopener">
          <span class="price-now">View</span><span class="label">Full Mailer</span>
        </a>
      </div>
    </div>
  </section>

  <!-- TRUST + URGENCY -->
  <section class="section tone-3" style="padding-top:2rem;padding-bottom:2rem;">
    <div class="bf-container">
      <ul class="trust">
        <li>🚚 Free Delivery over €50</li>
        <li>🏬 Click & Collect</li>
        <li>🇮🇪 Irish-Owned</li>
        <li>💫 Price Match Promise</li>
      </ul>
    </div>
  </section>
  <section class="section tone-1" style="padding-top:1rem;padding-bottom:3rem;">
    <div class="bf-container">
      <p class="urgency">⚡ Deals are going fast — grab yours before they’re gone!</p>
    </div>
  </section>
</div>








