{% assign hot_collection = collections['black-friday-hot-offers'] %}
{% assign picks_collection = collections['black-friday-picks'] %}
{% assign low_collection = collections['black-friday-super-low'] %}
{% assign mailer_url = page.metafields.custom.mailer_url.value | default: 'https://euronics.ie/mailer/black-friday-2025.pdf#toolbar=0' %}
{% assign guides = 
  "TV Buying Guide|/pages/tv-buying-guide|https://via.placeholder.com/400x250?text=TV+Guide,
   Coffee Machine Buying Guide|/pages/coffee-machine-buying-guide|https://via.placeholder.com/400x250?text=Coffee+Guide,
   Laptop Buying Guide|/pages/laptop-buying-guide|https://via.placeholder.com/400x250?text=Laptop+Guide,
   Washing Machine Buying Guide|/pages/washing-machine-buying-guide|https://via.placeholder.com/400x250?text=Laundry+Guide" | split: "," %}

<style>
  :root {
    --black:#0A0A0A;
    --offblack:#111111;
    --card:#1A1A1A;
    --border:#222222;
    --gold:#FECF2F;
    --blue:#005EB8;
    --text:#F5F5F5;
    --muted:#9CA3AF;
  }

  .bf-page * { box-sizing: border-box; }
  .bf-page {
    font-family: system-ui, -apple-system, Roboto, Helvetica, Arial, sans-serif;
    color: var(--text);
    background-image:
      repeating-linear-gradient(45deg, rgba(255,255,255,0.06) 0, rgba(255,255,255,0.06) 1px, transparent 1px, transparent 20px),
      linear-gradient(0deg, rgba(0,0,0,0.55), rgba(0,0,0,0.55)),
      url('https://cdn.shopify.com/s/files/1/0550/5807/1748/files/Untitled_design_37.png?v=1760479194');
    background-size: auto, cover, cover;
    background-position: center;
    background-attachment: fixed;
  }

  .bf-container { max-width: 1200px; margin: 0 auto; padding: 0 1.25rem; }
  h1,h2 { font-weight: 800; letter-spacing: -.02em; margin-bottom: .5rem; }
  h1 { font-size: clamp(2.5rem, 4vw, 4.25rem); color: var(--gold); text-align: center; }
  h2 { font-size: clamp(1.5rem, 2.2vw, 2rem); color: var(--gold); text-align: center; }
  .section { padding: 4rem 0; }

  /* Buttons */
  .price-btn {
    display: flex !important;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;
    background: linear-gradient(90deg, var(--gold), var(--blue));
    color: var(--black) !important;
    font-weight: 900 !important;
    font-size: 1.2rem !important;
    text-transform: uppercase;
    padding: 1.1rem 2.5rem !important;
    border-radius: 16px !important;
    box-shadow: 0 0 20px rgba(254,207,47,0.4);
    transition: all 0.3s ease-in-out;
    margin: 1rem auto 0 auto;
    text-align: center;
    width: fit-content;
  }
  .price-btn:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 0 30px rgba(254,207,47,0.6);
  }
  .price-btn .price-now {
    background: var(--black);
    color: var(--gold);
    border-radius: 10px;
    padding: 0.3rem 0.7rem;
    font-weight: 800;
    font-size: 1.25rem;
  }
  .price-btn .label { color: #fff; font-weight: 800; letter-spacing: .5px; }

  /* Grids */
  .grid { display: grid; gap: 1.25rem; }
  .grid-3 { grid-template-columns: repeat(3, 1fr); }
  .grid-4 { grid-template-columns: repeat(4, 1fr); }
  @media(max-width:1024px){ .grid-3, .grid-4 { grid-template-columns: repeat(2, 1fr); } }
  @media(max-width:640px){ .grid-3 { grid-template-columns: repeat(3,1fr) !important; } .grid-4 { grid-template-columns: repeat(2,1fr) !important; } }

  /* Top picks grid fix */
  .carousel { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; overflow: hidden; }
  @media(max-width:1024px){ .carousel { grid-template-columns: repeat(2,1fr); } }
  @media(max-width:640px){ .carousel { grid-template-columns: repeat(2,1fr) !important; } }

  .card { background: var(--card); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; transition: transform .2s; }
  .card:hover { transform: translateY(-2px); }

  .pimg-wrap { width: 100%; aspect-ratio: 4 / 3; background: #0f0f0f; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .pimg { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }

  .ptitle { font-weight: 700; margin: .6rem 0 .2rem; text-align: center; }
  .vendor { color: var(--muted); font-size: .9rem; margin-bottom: .35rem; text-align: center; }
  .price { display: flex; justify-content: center; gap: .6rem; flex-wrap: wrap; align-items: baseline; margin-top: .5rem; }
  .price-was { color: #96a3b8; text-decoration: line-through; font-size: .95rem; }
  .price-save { color: #dbe5f0; font-size: .95rem; }

  @media(max-width:640px){
    .bf-page .price-btn { width: 100% !important; padding: 1rem 1.25rem !important; min-width: unset !important; }
    .bf-page .price-btn .price-now { font-size: 1.05rem !important; }
  }
</style>

<div class="bf-page">
  <section class="section">
    <div class="bf-container">
      <h1>Black Friday Deals 2025</h1>
    </div>
  </section>

  <section class="section">
    <div class="bf-container">
      <h2>🔥 Hot Offers</h2>
      <div class="grid grid-3">
        {% for product in hot_collection.products limit:6 %}
          <article class="card">
            <div class="pimg-wrap">
              {% if product.featured_image %}
                <img class="pimg" src="{{ product.featured_image | img_url: '800x' }}" alt="{{ product.title }}">
              {% endif %}
            </div>
            <div style="padding:1rem;">
              <div style="text-align:center; font-weight:700;">{{ product.title }}</div>
              <div style="text-align:center; color:var(--muted);">by {{ product.vendor }}</div>
              {% if product.compare_at_price and product.compare_at_price > product.price %}
                <div style="text-align:center; margin:.5rem 0;">
                  <span style="text-decoration:line-through; color:#96a3b8;">{{ product.compare_at_price | money }}</span>
                  <span style="margin-left:.5rem; color:#dbe5f0;">Save {{ product.compare_at_price | minus: product.price | money }}</span>
                </div>
              {% endif %}
              <a href="{{ product.url }}" class="price-btn"><span class="price-now">{{ product.price | money }}</span><span class="label">Shop Now</span></a>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="bf-container">
      <h2>Top Black Friday Picks</h2>
      <div class="carousel">
        {% for product in picks_collection.products limit:6 %}
          <article class="card">
            <div class="pimg-wrap">
              {% if product.featured_image %}
                <img class="pimg" src="{{ product.featured_image | img_url: '800x' }}" alt="{{ product.title }}">
              {% endif %}
            </div>
            <div style="padding:1rem;">
              <div style="text-align:center; font-weight:700;">{{ product.title }}</div>
              <div style="text-align:center; color:var(--muted);">by {{ product.vendor }}</div>
              {% if product.compare_at_price and product.compare_at_price > product.price %}
                <div style="text-align:center; margin:.5rem 0;">
                  <span style="text-decoration:line-through; color:#96a3b8;">{{ product.compare_at_price | money }}</span>
                  <span style="margin-left:.5rem; color:#dbe5f0;">Save {{ product.compare_at_price | minus: product.price | money }}</span>
                </div>
              {% endif %}
              <a href="{{ product.url }}" class="price-btn"><span class="price-now">{{ product.price | money }}</span><span class="label">Shop Now</span></a>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="bf-container">
      <h2>Super Low Deals</h2>
      <div class="grid grid-4">
        {% for product in low_collection.products limit:8 %}
          <article class="card">
            <div class="pimg-wrap">
              {% if product.featured_image %}
                <img class="pimg" src="{{ product.featured_image | img_url: '800x' }}" alt="{{ product.title }}">
              {% endif %}
            </div>
            <div style="padding:1rem;">
              <div style="text-align:center; font-weight:700;">{{ product.title }}</div>
              <div style="text-align:center; color:var(--muted);">by {{ product.vendor }}</div>
              {% if product.compare_at_price and product.compare_at_price > product.price %}
                <div style="text-align:center; margin:.5rem 0;">
                  <span style="text-decoration:line-through; color:#96a3b8;">{{ product.compare_at_price | money }}</span>
                  <span style="margin-left:.5rem; color:#dbe5f0;">Save {{ product.compare_at_price | minus: product.price | money }}</span>
                </div>
              {% endif %}
              <a href="{{ product.url }}" class="price-btn"><span class="price-now">{{ product.price | money }}</span><span class="label">Shop Now</span></a>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="bf-container" style="text-align:center;">
      <h2>See Our Black Friday Mailer</h2>
      <iframe class="mailer-frame" src="{{ mailer_url }}" title="Black Friday Mailer"></iframe>
      <div style="margin-top:1.5rem;">
        <a class="price-btn" href="{{ mailer_url }}" target="_blank"><span class="price-now">View</span><span class="label">Full Mailer</span></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="bf-container">
      <h2>Black Friday Buying Guides</h2>
      <div class="grid grid-4">
        {% for item in guides %}
          {% assign g = item | split: '|' %}
          <article class="card">
            <div class="pimg-wrap">
              <img class="pimg" src="{{ g[2] | strip }}" alt="{{ g[0] | strip }}">
            </div>
            <div style="padding:1rem; text-align:center;">
              <div style="font-weight:700; color:var(--gold);">{{ g[0] | strip }}</div>
              <a href="{{ g[1] | strip }}" class="price-btn" style="margin-top:1rem;"><span class="label">Read Guide</span></a>
            </div>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>
</div>

















