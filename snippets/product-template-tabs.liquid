                      class="card__collapsible-button"
                      data-action="toggle-collapsible"
                      aria-expanded="false"
                      aria-controls="global-tab-{{ i }}"
                    >
                      <span class="card__title heading h3">{{ global_tab_page.title }}</span>
                      <span class="plus-button plus-button--large"></span>
                    </button>
  
                    <div id="global-tab-{{ i }}" class="card__collapsible">
                      <div class="card__collapsible-content">
                        <div class="rte text--pull">
                          {{ global_tab_page.content }}
                        </div>
                      </div>
                    </div>
                  {%- else -%}
                    <div class="card__header">
                      <h2 class="card__title heading h3">{{ global_tab_page.title }}</h2>
                    </div>
  
                    <div class="card__section" aria-expanded="true">
                      <div class="rte text--pull">
                        {{ global_tab_page.content }}
                      </div>
  
                      {% comment %} <button class="expandable-content__toggle">
                        <span class="expandable-content__toggle-icon"></span>
                        <span
                          class="expandable-content__toggle-text"
                          data-view-more="{{ 'product.general.view_more' | t | escape }}"
                          data-view-less="{{ 'product.general.view_less' | t | escape }}"
                        >
                          {{- 'product.general.view_more' | t -}}
                        </span>
                      </button> {% endcomment %}
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endunless -%}
          {%- endfor -%}
      </div>
      <div class="card__tab-panel hidden" id="tab-specs">
        {% assign specs_json = product.metafields.custom.specs.value | parse_json %}

