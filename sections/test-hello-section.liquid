<section id="euronics-audio-section" style="background:#f9fafb;">
  <style>
    #euronics-audio-section .container{max-width:1200px;margin:0 auto;padding:0 1.5rem;}
    #euronics-audio-section h2,#euronics-audio-section h3,#euronics-audio-section h4{
      text-align:center;font-weight:700;line-height:1.25;
    }
    #euronics-audio-section .hero{
      position:relative;height:60vh;display:flex;align-items:center;justify-content:center;
      text-align:center;color:#fff;background-size:cover;background-position:center;
    }
    #euronics-audio-section .overlay{
      background:rgba(0,0,0,.45);padding:2rem;border-radius:1rem;max-width:700px;margin:0 1rem;
    }
    #euronics-audio-section .btn{
      display:inline-block;background:#1e40af;color:#fff !important;padding:.75rem 1.5rem;
      border-radius:.5rem;text-decoration:none;font-weight:600;transition:background .3s;
    }
    #euronics-audio-section .btn:hover{background:#1d4ed8}
    #euronics-audio-section .section{padding:4rem 0;}
    #euronics-audio-section .grid{display:grid;gap:2rem;}
    @media(min-width:768px){
      #euronics-audio-section .grid-2{grid-template-columns:repeat(2,1fr);}
      #euronics-audio-section .grid-4{grid-template-columns:repeat(4,1fr);}
      #euronics-audio-section .grid-5{grid-template-columns:repeat(5,1fr);}
    }
    #euronics-audio-section .card{
      background:#fff;border-radius:1rem;box-shadow:0 2px 8px rgba(0,0,0,.05);
      padding:1.5rem;text-align:center;
    }
    #euronics-audio-section img{width:100%;border-radius:1rem 1rem 0 0;height:auto;}
  </style>

  <!-- Hero -->
  <div class="hero" style="background-image:url('{{ section.settings.hero_image | image_url: width: 2000 }}');">
    <div class="overlay">
      <h2>{{ section.settings.hero_heading }}</h2>
      <p style="margin-bottom:1.5rem;">{{ section.settings.hero_subheading }}</p>
      <a href="{{ section.settings.hero_button_link }}" class="btn">{{ section.settings.hero_button_label }}</a>
    </div>
  </div>

  <!-- WHY CHOOSE -->
  <div class="section bg-white">
    <div class="container">
      <h3>{{ section.settings.why_heading }}</h3>
      <p style="max-width:600px;margin:1.5rem auto 2rem;text-align:center;">{{ section.settings.why_text }}</p>
      <div class="grid grid-4">
        {% for block in section.blocks %}
          {% if block.type == 'why_box' %}
            <div class="card" {{ block.shopify_attributes }}>
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.text }}</p>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="btn">{{ block.settings.button_text }}</a>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- SOUNDBARS -->
  <div class="section bg-white">
    <div class="container">
      <h3>{{ section.settings.soundbar_heading }}</h3>
      <div class="grid grid-2">
        {% for block in section.blocks %}
          {% if block.type == 'soundbar' %}
            <div class="card" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title }}">
              {% endif %}
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.text }}</p>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="btn">{{ block.settings.button_text }}</a>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- HEADPHONES -->
  <div class="section" style="background:#f3f4f6;">
    <div class="container">
      <h3>{{ section.settings.headphones_heading }}</h3>
      <p style="max-width:700px;margin:1.5rem auto 2rem;text-align:center;">{{ section.settings.headphones_text }}</p>
      <div class="grid grid-5">
        {% for block in section.blocks %}
          {% if block.type == 'headphone' %}
            <div class="card" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title }}">
              {% endif %}
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.text }}</p>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="btn">{{ block.settings.button_text }}</a>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Euronics Audio Experience",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_heading", "label": "Hero heading", "default": "Hear the Difference" },
    { "type": "text", "id": "hero_subheading", "label": "Hero subheading", "default": "Better Sound Starts Here" },
    { "type": "text", "id": "hero_button_label", "label": "Hero button text", "default": "Explore Audio" },
    { "type": "url", "id": "hero_button_link", "label": "Hero button link" },
    { "type": "text", "id": "why_heading", "label": "Why Choose heading", "default": "Why Choose Euronics for Audio" },
    { "type": "text", "id": "why_text", "label": "Why Choose description", "default": "We believe great sound transforms everyday experiences." },
    { "type": "text", "id": "soundbar_heading", "label": "Soundbars heading", "default": "Top Soundbars" },
    { "type": "text", "id": "headphones_heading", "label": "Headphones heading", "default": "Headphones & Personal Audio" },
    { "type": "text", "id": "headphones_text", "label": "Headphones intro", "default": "Explore our premium headphone range featuring top brands that combine comfort, clarity, and innovation for every listener." }
  ],
  "blocks": [
    {
      "type": "why_box",
      "name": "Why Choose Box",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Shop Soundbars" },
        { "type": "text", "id": "text", "label": "Text", "default": "Explore our full soundbar range" },
        { "type": "url", "id": "link", "label": "Button link" },
        { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop Now" }
      ]
    },
    {
      "type": "soundbar",
      "name": "Soundbar Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Button link" },
        { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop Now" }
      ]
    },
    {
      "type": "headphone",
      "name": "Headphone Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Button link" },
        { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop Now" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Euronics Audio Experience",
      "blocks": [
        { "type": "why_box" },
        { "type": "soundbar" },
        { "type": "headphone" }
      ]
    }
  ]
}
{% endschema %}

