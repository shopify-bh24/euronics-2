<section id="euronics-audio-section">
  <style>
    #euronics-audio-section * {
      box-sizing: border-box;
      font-family: inherit;
    }

    #euronics-audio-section {
      background: #f9fafb;
      color: var(--color-foreground, #111827);
      font-size: 1rem;
      line-height: 1.6;
    }

    #euronics-audio-section .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    #euronics-audio-section h2,
    #euronics-audio-section h3,
    #euronics-audio-section h4 {
      text-align: center;
      font-weight: 700;
      line-height: 1.25;
      color: inherit;
    }

    #euronics-audio-section h2 { font-size: 2.25rem; margin-bottom: 1rem; }
    #euronics-audio-section h3 { font-size: 1.75rem; margin-bottom: 1rem; }
    #euronics-audio-section h4 { font-size: 1.25rem; margin-bottom: 0.75rem; }

    #euronics-audio-section .hero {
      position: relative;
      height: 60vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: #fff;
      background-size: cover;
      background-position: center;
    }

    #euronics-audio-section .overlay {
      background: rgba(0, 0, 0, 0.45);
      padding: 2rem;
      border-radius: 1rem;
      max-width: 700px;
      margin: 0 1rem;
    }

    #euronics-audio-section p {
      color: inherit;
      font-size: 1rem;
      margin-bottom: 1rem;
    }

    #euronics-audio-section .btn {
      display: inline-block;
      background: #1e40af;
      color: #fff !important;
      padding: 0.75rem 1.5rem;
      border-radius: 0.5rem;
      text-decoration: none;
      font-weight: 600;
      font-size: 1rem;
      text-align: center;
      cursor: pointer;
      min-width: 160px;
      transition: background 0.3s ease;
    }

    #euronics-audio-section .btn:hover { background: #1d4ed8; }

    #euronics-audio-section .section { padding: 4rem 0; }

    #euronics-audio-section .grid {
      display: grid;
      gap: 2rem;
    }

    @media (min-width: 768px) {
      #euronics-audio-section .grid-2 { grid-template-columns: repeat(2, 1fr); }
      #euronics-audio-section .grid-4 { grid-template-columns: repeat(4, 1fr); }
      #euronics-audio-section .grid-5 { grid-template-columns: repeat(5, 1fr); }
    }

    #euronics-audio-section .card {
      background: #fff;
      border-radius: 1rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      padding: 1.5rem;
      text-align: center;
    }

    #euronics-audio-section img {
      width: 100%;
      border-radius: 1rem 1rem 0 0;
      height: auto;
      margin-bottom: 1rem;
    }

    /* Brand Carousel */
    #euronics-audio-section .brand-carousel {
      overflow: hidden;
      position: relative;
      width: 100%;
      margin-top: 1rem;
    }

    #euronics-audio-section .brand-track {
      display: flex;
      gap: 4rem;
      animation: scrollBrands 30s linear infinite;
    }

    #euronics-audio-section .brand-track img {
      height: 70px;
      object-fit: contain;
      filter: grayscale(100%);
      opacity: 0.8;
      transition: filter 0.3s, opacity 0.3s;
    }

    #euronics-audio-section .brand-track img:hover {
      filter: grayscale(0%);
      opacity: 1;
    }

    @keyframes scrollBrands {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    @media (max-width: 768px) {
      #euronics-audio-section .section { padding: 2.5rem 0; }
      #euronics-audio-section h2 { font-size: 1.75rem; }
      #euronics-audio-section h3 { font-size: 1.5rem; }
      #euronics-audio-section h4 { font-size: 1.1rem; }
      #euronics-audio-section .brand-track { gap: 2rem; }
      #euronics-audio-section .brand-track img { height: 50px; }
    }
  </style>

  <!-- HERO -->
  <div
    class="hero"
    style="background-image:url('https://cdn.shopify.com/s/files/1/0550/5807/1748/files/Hero_section_banner_sound_guide.png?v=1760348913');"
  >
    <div class="overlay">
      <h2>Hear the Difference</h2>
      <p>Better Sound Starts Here</p>
      <a href="https://euronics.ie/collections/audio-1" class="btn">Explore Audio</a>
    </div>
  </div>

  <!-- WHY CHOOSE EURONICS -->
  <div class="section bg-white">
    <div class="container">
      <h3>Why Choose Euronics for Audio</h3>
      <p style="max-width:600px;margin:1.5rem auto 2rem;text-align:center;">
        We believe great sound transforms everyday experiences. From movies to music, Euronics helps you find the perfect system for your home, powered by trusted local expertise and world-leading brands.
      </p>
      <div class="grid grid-4">
        <div class="card">
          <h4>Soundbars</h4>
          <p>Explore our full range of premium soundbars designed to enhance your home cinema experience.</p>
          <a href="https://euronics.ie/collections/soundbars" class="btn">Shop Soundbars</a>
        </div>
        <div class="card">
          <h4>Headphones</h4>
          <p>Discover high-quality headphones from top brands for superior personal audio.</p>
          <a href="https://euronics.ie/collections/headphones" class="btn">Shop Headphones</a>
        </div>
        <div class="card">
          <h4>Bluetooth Speakers</h4>
          <p>Portable and powerful speakers perfect for any occasion, from home to outdoors.</p>
          <a href="https://euronics.ie/collections/wireless-speakers" class="btn">Shop Bluetooth Speakers</a>
        </div>
        <div class="card">
          <h4>Party Speakers</h4>
          <p>Turn up the energy with dynamic speakers built for big sound and bold performance.</p>
          <a href="https://euronics.ie/collections/wireless-speakers" class="btn">Shop Party Speakers</a>
        </div>
      </div>
    </div>
  </div>

  <!-- BRAND LOGO CAROUSEL -->
  <div class="section bg-white" style="padding:2rem 0;border-top:1px solid #eee;border-bottom:1px solid #eee;">
    <div class="container">
      <h3 style="margin-bottom:2rem;">Trusted Audio Brands at Euronics</h3>
      <div class="brand-carousel">
        <div class="brand-track">
          <img src="https://cdn.shopify.com/s/files/1/0550/5807/1748/files/logo_Samsung.png?v=1760363098" alt="Samsung" />
          <img src="https://cdn.shopify.com/s/files/1/0550/5807/1748/files/logo_LG.png?v=1760362939" alt="LG" />
          <img src="https://cdn.shopify.com/s/files/1/0550/5807/1748/files/logo_Sony.png?v=1760363214" alt="Sony" />
          <img src="https://cdn.shopify.com/s/files/1/0550/5807/1748/files/logo_jbl.png?v=1760363312" alt="JBL" />
          <img src="https://cdn.shopify.com/s/files/1/0550/5807/1748/files/logo_sennheiser.png?v=1760363401" alt="Sennheiser" />
          <img src="https://cdn.shopify.com/s/files/1/0550/5807/1748/files/logo_soundcore.png?v=1760363579" alt="Soundcore" />
          <img src="https://cdn.shopify.com/s/files/1/0550/5807/1748/files/logo_apple.png?v=1760363720" alt="Apple" />
        </div>
      </div>
    </div>
  </div>

  <!-- TOP SOUNDBARS -->
  <div class="section bg-white">
    <div class="container">
      <h3>Top Soundbars</h3>
      <div class="grid grid-2">
        <div class="card">
          <img src="https://cdn.shopify.com/s/files/1/0550/5807/1748/files/Samsung_Sound_guide.png?v=1760349759" alt="Samsung Soundbar" />
          <h4>Samsung Q-Series Soundbar</h4>
          <p>Immerse yourself in cinematic Dolby Atmos sound with Q-Symphony technology, perfectly tuned for Samsung TVs.</p>
          <a href="https://euronics.ie/collections/soundbars?pf_v_brand=Samsung" class="btn">Shop Samsung Soundbars</a>
        </div>
        <div class="card">
          <img src="https://cdn.shopify.com/s/files/1/0550/5807/1748/files/LG_Sound_guide.png?v=1760350087" alt="LG Soundbar" />
          <h4>LG Soundbar Series</h4>
          <p>Bring your entertainment to life with Dolby Atmos and Meridian Audio technology in LG’s premium soundbars.</p>
          <a href="https://euronics.ie/collections/soundbars?pf_v_brand=LG" class="btn">Shop LG Soundbars</a>
        </div>
      </div>
    </div>
  </div>

  <!-- HEADPHONES -->
  <div class="section" style="background:#f3f4f6;">
    <div class="container">
      <h3>Headphones & Personal Audio</h3>
      <p style="max-width:700px;margin:1.5rem auto 2rem;text-align:center;">
        Explore our premium headphone range featuring top brands that combine comfort, clarity, and innovation for every listener.
      </p>
      <div class="grid grid-5">
        <div class="card">
          <img src="https://cdn.shopify.com/s/files/1/0550/5807/1748/files/sennheizer_product_guide.png?v=1760350596" alt="Sennheiser" />
          <h4>Sennheiser</h4>
          <p>Precision German engineering meets exceptional audio fidelity.</p>
          <a href="https://euronics.ie/collections/sennheiser" class="btn">Shop Sennheiser</a>
        </div>
        <div class="card">
          <img src="https://cdn.shopify.com/s/files/1/0550/5807/1748/files/sony_product_guide.png?v=1760350965" alt="Sony" />
          <h4>Sony</h4>
          <p>Industry-leading noise cancellation and immersive audio design.</p>
          <a href="https://euronics.ie/collections/sony-headphones" class="btn">Shop Sony</a>
        </div>
        <div class="card">
          <img src="https://cdn.shopify.com/s/files/1/0550/5807/1748/files/jbl_product_guide.png?v=1760351447" alt="JBL" />
          <h4>JBL</h4>
          <p>Powerful sound and bold design for every lifestyle.</p>
          <a href="https://euronics.ie/collections/jbl" class="btn">Shop JBL</a>
        </div>
        <div class="card">
          <img src="https://cdn.shopify.com/s/files/1/0550/5807/1748/files/Soundcore_product_guide.png?v=1760352885" alt="Soundcore" />
          <h4>Soundcore</h4>
          <p>Innovative sound and all-day comfort at great value.</p>
          <a href="https://euronics.ie/collections/soundcore" class="btn">Shop Soundcore</a>
        </div>
        <div class="card">
          <img src="https://cdn.shopify.com/s/files/1/0550/5807/1748/files/apple_product_guide.png?v=1760353176" alt="Apple" />
          <h4>Apple</h4>
          <p>Seamless wireless performance and signature Apple design.</p>
          <a href="https://euronics.ie/collections/headphones?pf_v_brand=Apple" class="btn">Shop Apple</a>
        </div>
      </div>
    </div>
  </div>

    <!-- CUSTOMER FAVOURITES -->
  <div class="section bg-white">
    <div class="container">
      <h3>Customer Favourites</h3>
      <p style="max-width:700px;margin:1.5rem auto 2rem;text-align:center;">
        Explore our most popular picks — trusted by customers across Ireland for unbeatable sound quality and performance.
      </p>

      {% assign fav_collection = collections['656732717383'] %}
      {% if fav_collection and fav_collection.products.size > 0 %}
        <div class="favourites-carousel">
          <div class="carousel-track">
            {% for product in fav_collection.products limit:6 %}
              <div class="carousel-item card">
                <a href="{{ product.url }}">
                  <img
                    src="{{ product.featured_image | img_url: '600x600' }}"
                    alt="{{ product.title | escape }}"
                  />
                </a>
                <h4>{{ product.title }}</h4>
                {% if product.price %}
                  <p style="font-weight:600;font-size:1.1rem;color:#1e40af;">
                    {{ product.price | money }}
                  </p>
                {% endif %}
                <a href="{{ product.url }}" class="btn">Shop Now</a>
              </div>
            {% endfor %}
          </div>
        </div>

        <div style="text-align:center;margin-top:3rem;">
          <a
            href="/collections/656732717383"
            class="btn"
            style="min-width:200px;display:inline-block;"
          >
            View All Favourites
          </a>
        </div>
      {% else %}
        <p style="text-align:center;color:#6b7280;">
          No featured products available right now — check back soon!
        </p>
      {% endif %}
    </div>
  </div>

  <style>
    /* Carousel styling */
    #euronics-audio-section .favourites-carousel {
      position: relative;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      margin: 0 -1rem;
    }

    #euronics-audio-section .carousel-track {
      display: flex;
      gap: 1.5rem;
      padding: 1rem;
      scroll-snap-type: x mandatory;
    }

    #euronics-audio-section .carousel-item {
      flex: 0 0 calc(33.333% - 1rem);
      scroll-snap-align: start;
      background: #fff;
      border-radius: 1rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      text-align: center;
      padding: 1rem;
    }

    #euronics-audio-section .carousel-item img {
      width: 100%;
      height: auto;
      border-radius: 0.75rem;
      margin-bottom: 0.75rem;
    }

    @media (max-width: 1024px) {
      #euronics-audio-section .carousel-item {
        flex: 0 0 calc(50% - 1rem);
      }
    }

    @media (max-width: 768px) {
      #euronics-audio-section .carousel-item {
        flex: 0 0 calc(80% - 1rem);
      }
    }

    /* Optional: subtle fade mask on edges */
    #euronics-audio-section .favourites-carousel::before,
    #euronics-audio-section .favourites-carousel::after {
      content: "";
      position: absolute;
      top: 0;
      width: 40px;
      height: 100%;
      z-index: 1;
      pointer-events: none;
    }
    #euronics-audio-section .favourites-carousel::before {
      left: 0;
      background: linear-gradient(to right, #fff, transparent);
    }
    #euronics-audio-section .favourites-carousel::after {
      right: 0;
      background: linear-gradient(to left, #fff, transparent);
    }
  </style>

</section>


