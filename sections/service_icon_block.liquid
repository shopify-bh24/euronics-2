<div class="service_icon_block">
  <div class="container container--flush">
    <div class="text_imag_bg" {% if section.settings.bg_color != blank %}style="background:{{ section.settings.bg_color }};"{% endif %}>
      <div class="flex_row">
        <div class="half_content_div left_div{% if section.settings.text_alignment == 'right' %} last_div{% endif %}">
          <div class="inner_left_content">
            {%- if section.settings.logo_image -%}<img class="logo_img_div" src="{{ section.settings.logo_image | img_url:'master' }}" alt="{{ section.settings.logo_image | handle }}" title="{{ section.settings.logo_image | handle }}" />{%- endif -%}
            {%- if section.settings.title != blank -%}<h2 class="left_title" {% if section.settings.title_color != blank %}style="color:{{ section.settings.title_color }};"{% endif %}>{{ section.settings.title }}</h2>{%- endif -%}
            {%- if section.settings.description != blank -%}
            <div class="desc_div">
              {{ section.settings.description }}
            </div>
            {%- endif -%}
          </div>
        </div>
        <div class="half_content_div right_div{% if section.settings.text_alignment == 'right' %} first_div{% endif %}">
          <div class="inner_right_content">
            <div class="video_url_div">
              {%- if section.settings.image_div -%}
              <img src="{{ secttion.settings.image_div | img_url:'master' }}" alt="{{ secttion.settings.image_div | handle }}" title="{{ secttion.settings.image_div | handle }}" />
              {%- else -%}
              {%- if section.settings.you_tube_url != blank -%}
              {%- assign videoId = section.settings.you_tube_url -%}
              {%- if videoId contains 'vimeo' -%}
              {%- assign vdo_src = videoId -%}
              {%- else -%}
              {%- assign vdo_url = videoId  | split: '?v=' -%}  
              {%- assign vdo_srcs = 'http://www.youtube.com/embed/'| append:vdo_url[1] -%}
              {%- assign vdo_src = vdo_srcs | append:'?autoplay=1&mute=1&enablejsapi=1' -%}
              {%- endif -%}      
              <div class="vimeo-wrapper"><iframe src="{{ vdo_src }}?api=1&player_id=video-iframe&autoplay=1&muted=1&loop=1&color=ffffff" webkitallowfullscreen="" mozallowfullscreen="" allowfullscreen="" frameborder="0" include></iframe></div>
              {%- elsif section.settings.video_url != blank -%}
              <video id="serv_video" width="100%" height="100%" controls autoplay loop muted playsinline><source src="{{ section.settings.video_url }}" type="video/mp4"></video>
              <div class="video_plau_pause_btn">
                <a href="javascript:void(0);" class="play_btns vdo_btn">{%- include 'icon_play' -%}</a>
                <a href="javascript:void(0);" class="pause_btns vdo_btn">{%- include 'icon_pause' -%}</a>
              </div>
              {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>      
      <div class="service_icon_text">
        <ul class="service_slider">
          {%- for block in section.blocks -%}
          <li>
            <div class="service_text">
              {%- if block.settings.serv_icon -%}
              <span class="icon_image">
                <img src="{{ block.settings.serv_icon | img_url:'master' }}" alt="{{ block.settings.serv_icon | handle }}" title="{{ block.settings.serv_icon | handle }}" />
              </span>
              {%- endif -%}
              <div class="serve_des">
                {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
              </div>
            </div>
          </li>
          {%- endfor-%}
        </ul>
      </div>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Service Icon BLock",
    "settings": [{
        "type": "color",
        "id": "bg_color",
        "label": "Section Background Color"
    },
	{
        "type": "image_picker",
        "id": "logo_image",
        "label": "Logo Image"
    },
	{
		"type": "text",
		"id": "title",
		"label": "Title"
	},
	{
		"type": "color",
		"id": "title_color",
		"label": "Title Color"
	},
	{
		"type": "richtext",
		"id": "description",
		"label": "Content"
	},
	{
		"type": "select",
		"id": "text_alignment",
		"label": "Content Alignment",
		"options": [{
			"value": "left",
			"label": "Left"
		},
		{
			"value": "right",
			"label": "Right"
		}]
	},
	{
		"type": "image_picker",
		"id": "image_div",
		"label": "Video Image"
	},
	{
		"type": "url",
		"id": "video_url",
		"label": "Video URL"
	},
    {
        "type": "video_url",
        "id": "you_tube_url",
        "label": "Slider Video",
        "accept": ["youtube", "vimeo"]
    }],
	"blocks": [{
		"type": "service_icon",
		"name": "Service Icon Block",
		"settings": [{
			"type": "image_picker",
			"id": "serv_icon",
			"label": "Service Icon Image"
		},
		{
			"type": "text",
			"id": "title",
			"label": "Service Title"
		}]
	}]
  }
{% endschema %}