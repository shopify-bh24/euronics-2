<div class="product_metafields_description_container">
    {% assign metafield_keys = "product_gallery_metafield_description_1,product_gallery_metafield_description_2,product_gallery_metafield_description_3,product_gallery_metafield_description_4,product_gallery_metafield_description_5,product_gallery_metafield_description_6" | split: "," %}
    
    
    {%  if metafield_keys != blank %} 
      <h3>At a glance</h3>
    {% endif %}
    {% for key in metafield_keys %}
      {% assign value = product.metafields.custom[key] %}
      {% if value != blank %}
        <div class="product_metafields_description_cell">{{ value }}</div>
      {% endif %}
    {% endfor %}
</div>


<style>
  .product_metafields_description_container{
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    padding: 0px 40px;
    padding-bottom: 20px;
    justify-content: center;
  }

  .product_metafields_description_container h3{
    width: 100%;
    font-size: 22px;
    font-weight: 600;
    margin-bottom: -14px;
    font-family: sans-serif;
    color: #1d428a;
  }

  .product_metafields_description_cell{
    max-width: 180px; 
    background: #f9f9f9;
    border-radius: 12px;
    padding: 12px;
    color: #1d428a;
  }


  @media screen and (max-width: 450px) {
    .product_metafields_description_container{
      padding: 0px 20px;
      padding-bottom: 20px;
    }

    .product_metafields_description_cell{
      max-width: 150px;
    }
  }
</style>