{%- assign navigation_menu_handle = section.settings.navigation_menu | default: 'main-menu' -%}
{%- assign navigation_menu = linklists[navigation_menu_handle] -%}

<style>
  {% if section.settings.bg_color != blank %}
    #shopify-section-{{ section.id }} .menu-with-image__menu-container{
      background:{{ section.settings.bg_color }};
    }
  {% endif %}
  {% if section.settings.text_color != blank %}
    #shopify-section-{{ section.id }} .menu-with-image__menu-container,
    #shopify-section-{{ section.id }} .link:hover, #shopify-section-{{ section.id }} .link:focus,
    #shopify-section-{{ section.id }} .h3{
      color:{{ section.settings.text_color }};
    }
  {% endif %}
</style>


<section class="section" data-section-id="{{ section.id }}" data-section-type="menu-section">
  <div class="container">
    <div class="menu-section__wrapper">
      <div class="menu-with-image">
        <div class="menu-with-image__menu-container">
          <div class="step-counter">
            <span>Step</span>
            <span class="counter">1</span>
            <span>/3</span> 
          </div>
          {%- if section.settings.title != blank -%}
            <header class="section__header">
              <h2 class="section__title heading h3">{{ section.settings.title | escape }}</h2>
            </header>
          {%- endif -%}
          {%- assign file_extension = 'png' -%}
          <div class="menu-step menu-step1" data-step="1">
            <div class="menu-step__links">
              {%- for link in navigation_menu.links -%}
                {%- assign image = link.title | handle | append: '.' | append: file_extension | file_img_url: '40x' | prepend: 'https:' -%}
                <div class="menu-link">
                  <a href="{{ link.url }}" class="nav-bar__link link" {% unless link.links.size == 0 %}data-link="{{ link.title | handle }}"{% endunless %}>
                    <img src="{{ image }}">
                    {{- link.title -}}
                  </a>
                </div>
              {%- endfor -%}
            </div>
          </div>
          <div class="menu-step menu-step2" data-step="2">
            <div class="menu-step__links">
              {%- for link in navigation_menu.links -%}
                {%- assign image = link.title | handle | append: '.' | append: file_extension | file_img_url: '40x' | prepend: 'https:' -%}
                {% unless link.links.size == 0 %}
                  <div class="menu-link" data-handle="{{ link.title | handle }}">
                    <ul>
                      {%- for sub_link in link.links -%}
                        <li>
                          <a href="{{ sub_link.url }}" class="nav-bar__link link" {% unless sub_link.links.size == 0 %}data-link="{{ link.title | handle }}_{{ sub_link.title | handle }}"{% endunless %}>
                            <img src="{{ image }}">
                            {{ sub_link.title }}
                          </a>
                        </li>
                      {%- endfor -%}
                      {% assign subHandle = link.title | handle %}
                      {% assign additionalMenuHandle = section.settings.additional_menu_handle | handle %}

                      {%- if additionalMenuHandle == subHandle -%}
                        {%- for additional_link in linklists[section.settings.additional_menu].links -%}
                          <li>
                            <a href="{{ additional_link.url }}" class="nav-bar__link link" {% unless additional_link.links.size == 0 %}data-link="{{ additional_link.title | handle }}"{% endunless %}>
                              <img src="{{ image }}">
                              {{ additional_link.title }}
                            </a>
                          </li>
                        {%- endfor -%}
                      {%- endif -%}

                      {% assign additionalMenuHandle2 = section.settings.additional_menu_handle2 | handle %}
                      {%- if additionalMenuHandle2 == subHandle -%}
                        {%- for additional_link2 in linklists[section.settings.additional_menu2].links -%}
                          <li>
                            <a href="{{ additional_link.url }}" class="nav-bar__link link" {% unless additional_link2.links.size == 0 %}data-link="{{ subHandle }}_{{ additional_link2.title | handle }}"{% endunless %}>
                              <img src="{{ image }}">
                              {{ additional_link2.title }}
                            </a>
                          </li>
                        {%- endfor -%}
                      {%- endif -%}
                    </ul>
                  </div>
                {% endunless %}
              {%- endfor -%}
              <button class="step-back-button">&lt; Back</button>
            </div>
          </div>
          <div class="menu-step menu-step3" data-step="3">
            <div class="menu-step__links">
              {%- for link in navigation_menu.links -%}
                {%- assign image = link.title | handle | append: '.' | append: file_extension | file_img_url: '40x' | prepend: 'https:' -%}
                {%- unless link.links.size == 0 -%}
                  {%- for sub_link in link.links -%}
                    <div class="menu-link" data-handle="{{ link.title | handle }}_{{ sub_link.title | handle }}">
                      <ul>
                        {%- for sub_sub_link in sub_link.links -%}
                          <li>
                            <a href="{{ sub_sub_link.url }}" class="nav-bar__link link">
                              <img src="{{ image }}">
                              {{ sub_sub_link.title }}
                            </a>
                          </li>
                        {%- endfor -%}
                        {% comment %}
                        <li>
                          <a href="/collections/all" class="nav-bar__link link">
                            <img src="{{ image }}">
                            Shop all
                          </a>
                        </li>
                        {% endcomment %}
                      </ul>
                    </div>
                  {%- endfor -%}
                  
                  {% assign subHandle = link.title | handle %}
                  {% assign additionalMenuHandle = section.settings.additional_menu_handle | handle %}
                  {%- if additionalMenuHandle == subHandle -%}
                    {%- for additional_link in linklists[section.settings.additional_menu].links -%}
                      {%- unless additional_link.links.size == 0 -%}
                        <div class="menu-link" data-handle="{{ additional_link.title | handle }}">
                          <ul>
                            {%- for additional_sub_link in additional_link.links -%}
                              <li>
                                <a href="{{ additional_sub_link.url }}" class="nav-bar__link link">
                                  <img src="{{ image }}">
                                  {{ additional_sub_link.title }}
                                </a>
                              </li>
                            {%- endfor -%}
                            {% comment %}
                            <li>
                              <a href="/collections/all" class="nav-bar__link link">
                                <img src="{{ image }}">
                                Shop all
                              </a>
                            </li>
                            {% endcomment %}
                          </ul>
                        </div>
                      {%- endunless -%}
                    {%- endfor -%}
                  {%- endif -%}

                  {% assign subHandle = link.title | handle %}
                  {% assign additionalMenuHandle2 = section.settings.additional_menu_handle2 | handle %}
                  {%- if additionalMenuHandle2 == subHandle -%}
                    {%- for additional_link2 in linklists[section.settings.additional_menu2].links -%}
                      {%- unless additional_link2.links.size == 0 -%}
                        <div class="menu-link" data-handle="{{ subHandle }}_{{ additional_link2.title | handle }}">
                          <ul>
                            {%- for additional_sub2_link in additional_link2.links -%}
                              <li>
                                <a href="{{ additional_sub2_link.url }}" class="nav-bar__link link">
                                  <img src="{{ image }}">
                                  {{ additional_sub2_link.title }}
                                </a>
                              </li>
                            {%- endfor -%}
                            {% comment %}
                            <li>
                              <a href="/collections/all" class="nav-bar__link link">
                                <img src="{{ image }}">
                                Shop all
                              </a>
                            </li>
                            {% endcomment %}
                          </ul>
                        </div>
                      {%- endunless -%}
                    {%- endfor -%}
                  {%- endif -%}
              
                {%- endunless -%}
              {%- endfor -%}
              <button class="step-back-button">&lt; Back</button>
            </div>
          </div>
        </div>
        <div class="menu-with-image__image-container">
          {%- if section.settings.image_link != blank  -%}
          <a href="{{ section.settings.image_link }}">
          {%- endif -%}
            {%- if section.settings.image != blank -%}
              <div class="aspect-ratio" style="padding-bottom: 52.35%">
                {%- capture supported_sizes -%}{%- render 'image-size', sizes: '300,400,500,600,700,800,900,1000,1100,1200', image: section.settings.image -%}{%- endcapture -%}
                {%- assign image_url = section.settings.image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}
    
                <img class="lazyload image--fade-in" data-src="{{ image_url }}" data-widths="[{{ supported_sizes }}]" data-sizes="auto" alt="{{ section.settings.image.alt | escape }}">
    
                <noscript>
                  <img src="{{ section.settings.image | img_url: '800x' }}" alt="{{ section.settings.image.alt | escape }}">
                </noscript>
              </div>
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          {%- if section.settings.image_link != blank  -%}
          </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>


{% schema %}
  {
    "name": "Menu section",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image",
        "info": "1200 x 800px .jpg recommended"
      },
      {
        "type": "url",
        "id": "image_link",
        "label": "Image link"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading"
      },
      {
        "type": "header",
        "content": "Navigation"
      },
      {
        "type": "link_list",
        "id": "navigation_menu",
        "label": "Menu",
        "default": "main-menu"
      },
      {
        "type": "header",
        "content": "Additional menu 1"
      },
      {
        "type": "text",
        "id": "additional_menu_handle",
        "label": "Additional menu handle"
      },
      {
        "type": "link_list",
        "id": "additional_menu",
        "label": "Menu"
      },
      {
        "type": "header",
        "content": "Additional menu 2"
      },
      {
        "type": "text",
        "id": "additional_menu_handle2",
        "label": "Additional menu handle"
      },
      {
        "type": "link_list",
        "id": "additional_menu2",
        "label": "Menu"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text"
      }
    ],
    "presets": [
      {
        "name": "Menu section"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}