{% if template contains 'product' %}

  {%- assign sisupiref = 'sku'  -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  {%- assign sisstyleno = current_variant[sisupiref] -%} 
    <script type="application/json" id="sis-json-product-config">
    	{ 
    		"featured_product":{
    			 "name":{{ product.title | json }},
    			 "available": {{ product.available }},
    			 "type": {{ product.type | json }},
    			 "tags":{{ product.tags | json }},
    			 "images":[
    				{%- for image in product.images -%}
    					{
    						
    						
    						"id":{{image.id}},
    						"src":{{ image | image_url | json }}
    						{%-if image.url != blank-%},"url":{{ image.url | json }}{%- endif -%}
    						{%-if image.src != blank-%},"o_src":{{ image.src | image_url | json }}{%- endif -%}
    						{%-if image.alt != blank-%},"alt":{{ image.alt | json }}{%- endif -%}
    					}
    				{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
    			 ],
    			 "image": {
    			   "src":"{{ product.featured_image | image_url }}",  
    			   "alt":{{ product.featured_image.alt | json }}
    			  },
    			  "style":{{sisstyleno | strip_newlines | json }},
    			  "id":{{current_variant.id}},
    				{%-if current_variant.sku != blank-%}
    					"sku":{{ current_variant.sku | strip_newlines | json }},
    			  	{%-endif-%}
    			  	{%-if current_variant.barcode != blank-%}
    					"barcode":{{ current_variant.barcode | json }},
    				{%-endif-%}			
    				{%- if sisupiref == 'sku' -%}
    					{%-if current_variant.sku != blank-%}
    						"upi":{{ current_variant.sku | strip_newlines | json }}
    					{%-endif-%}
    				{%- else -%}
    					{%-if current_variant.barcode != blank-%}
    						"upi":{{ current_variant.barcode | json }}
    					{%-endif-%}                    
    				{%- endif -%}
    				{%-if current_variant.sku == blank and current_variant.barcode == blank -%}
    					"upi":{{ current_variant.product.handle | json }}
    				{%- endif -%}
    
    		 },
    		 "upis":[
    				   {%- assign variantsObject = product.variants -%}
    				   {%- for variant in variantsObject -%}
    				   {"id": {{ variant.id }},
    				   {%- if variant.image %}"image_id": {{ variant.image.id }},{% endif -%}
    				   {%- if sisupiref == 'sku' -%}
    					   {%-if variant.sku != blank-%}"upi":{{ variant.sku | strip_newlines | json }},{%-endif-%}
    				   {%- else -%}
    					   {%-if variant.barcode != blank-%}"upi":{{ variant.barcode | json }},{%-endif-%}                    
    				   {%- endif -%}
    				   {%-if variant.sku == blank and variant.barcode == blank -%}"upi":{{ variant.product.handle | strip_newlines | json }},{%-endif-%}
    				   {%-if variant.sku != blank-%}"sku":{{ variant.sku | strip_newlines | json }},{%-endif-%}
    				   {%-if variant.barcode != blank-%}"barcode":{{ variant.barcode | json }},{%-endif-%}
    				   "available": {{ variant.available }},                             
    				   "inventory_quantity": {{ variant.inventory_quantity }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
    		   ]
    	   }
    </script>


  
	<script type="text/javascript">
		var _stockinstore = _stockinstore || [];
		_stockinstore.push({ "site":"10270","applicationurl": ("https:" == document.location.protocol ? "https://" : "http://") + "stockinstore.net","assetsurl": ("https:" == document.location.protocol ? "https://" : "http://") + "assets.stockinstore.net"});
		(function() {
			var ma = document.createElement("script");
			ma.type = "text/javascript"; ma.async = 1;
			ma.src = _stockinstore[0].assetsurl + "/widgets/stockinstore-global.js";
			var mas = document.getElementsByTagName("script")[0];
			mas.parentNode.insertBefore(ma, mas);
		})();
	</script>
	<div data-sis-widget-description="stockinstore" data-sis-widget-id="274"></div>
{% endif %}