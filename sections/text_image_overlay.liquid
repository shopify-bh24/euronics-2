<div class="image_text_overlay_div">
  <div class="container container--flush">
    <div class="two_div_column"> 
      <div class="flex_row">
      	<div class="half_content_div left_div{% if section.settings.text_alignment == 'right' %} last_div{% endif %}">
          <div class="inner_left_content">
            <h2 class="left_title" style="color:{{ section.settings.title_color }};">{{ section.settings.title }}</h2>
            <div class="desc_div">
              {{ section.settings.description }}
            </div>
          </div>
        </div>
        <div class="half_content_div right_div{% if section.settings.text_alignment == 'right' %} first_div{% endif %}">
          <div class="inner_right_content">
            <div class="video_url_div">
              {%- if section.settings.select_view == 'image' -%}
              {%- if section.settings.image_div -%}
              <img src="{{ section.settings.image_div | img_url:'master' }}" alt="{{ section.settings.image_div | handle }}" title="{{ section.settings.image_div | handle }}" />
              {%- endif -%}
              {%- else -%}
              {%- if section.settings.you_tube_url != blank -%}
              {%- assign videoId = section.settings.you_tube_url -%}
              {%- if videoId contains 'vimeo' -%}
              {%- assign vdo_src = videoId -%}
              {%- else -%}
              {%- assign vdo_url = videoId  | split: '?v=' -%}  
              {%- assign vdo_srcs = 'http://www.youtube.com/embed/'| append:vdo_url[1] -%}
              {%- assign vdo_src = vdo_srcs | append:'?autoplay=1&mute=1&enablejsapi=1' -%}
              {%- endif -%}      
              <div class="vimeo-wrapper"><iframe src="{{ vdo_src }}?api=1&player_id=video-iframe&autoplay=1&muted=1&loop=1&color=ffffff" webkitallowfullscreen="" mozallowfullscreen="" allowfullscreen="" frameborder="0" include></iframe></div>
              {%- elsif section.settings.video_url != blank -%}
              <video id="myVideo" poster="{{ section.settings.image_div | img_url:'master' }}" width="100%" height="100%" loop muted playsinline><source src="{{ section.settings.video_url }}" type="video/mp4"></video>
              <div class="video_plau_pause_btn">
                <a href="javascript:void(0);" class="play_btn vdo_btn">{%- include 'icon_play' -%}</a>
                <a href="javascript:void(0);" class="pause_btn vdo_btn">{%- include 'icon_pause' -%}</a>
              </div>
              {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% schema %}
  {
    "name": "Text Image Overlay",
    "settings": [{
		"type": "text",
		"id": "title",
		"label": "Title"
	},
	{
		"type": "color",
		"id": "title_color",
		"label": "Title Color"
	},
	{
		"type": "richtext",
		"id": "description",
		"label": "Content"
	},
	{
		"type": "select",
		"id": "text_alignment",
		"label": "Content Alignment",
		"options": [{
			"value": "left",
			"label": "Left"
		},
		{
			"value": "right",
			"label": "Right"
		}]
	},
	{
		"type": "select",
		"id": "select_view",
		"label": "Image Or Video",
		"options": [{
			"value": "image",
			"label": "Image"
		},
		{
			"value": "video",
			"label": "Video"
		}]
	},
	{
		"type": "image_picker",
		"id": "image_div",
		"label": "Video Image"
	},
	{
		"type": "url",
		"id": "video_url",
		"label": "Video URL"
	},
    {
        "type": "video_url",
        "id": "you_tube_url",
        "label": "Slider Video",
        "accept": ["youtube", "vimeo"]
    }]
  }
{% endschema %}