<div class="black-friday-landing">
  <section class="hero">
    <h1>Black Friday Deals 2025</h1>
    <p>Massive discounts across tech, appliances & more.</p>
    <div id="countdown"></div>
    <a href="/collections/black-friday" class="btn-primary">Shop All Deals</a>
  </section>

  <section class="hot-offers">
    <h2>🔥 Hot Offers</h2>
    <div class="grid">
      {% for product in collections['black-friday-hot-offers'].products %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
  </section>

  <section class="black-friday-mailer">
    <h2>✉️ See Our Black Friday Mailer</h2>
    <iframe src="https://euronics.ie/mailer/black-friday-2025.pdf#toolbar=0" title="Black Friday Mailer"></iframe>
  </section>

  <section class="trust-strip">
    <ul>
      <li>🚚 Free Delivery over €50</li>
      <li>🏬 Click & Collect</li>
      <li>🇮🇪 Irish-Owned</li>
      <li>💫 Price Match Promise</li>
    </ul>
  </section>
</div>
