      "rich_text_PfKf9q": {
        "type": "rich-text",
        "settings": {
          "text_width": "wide",
          "title": "",
          "content": "<p>Euronics.ie is Ireland's leading retailer for top-brand TVs, kitchen appliances, and home electronics. With <strong>over 60 stores nationwide</strong>, each independently run by local business owners, we proudly <strong>support Shop Local</strong>. As <strong>kitchen appliance specialists</strong>, we stock <strong>Ireland's largest range of integrated home appliances </strong>from energy-efficient washing machines and dishwashers to advanced refrigeration and cooking solutions. Beyond the kitchen, we also carry the latest consumer electronics, such as laptops for work or school, plus high-tech gadgets like drones, backup power supplies, and innovative robot vacuums. Enjoy <strong>competitive prices</strong>, <strong>fast nationwide delivery</strong>, and <strong>expert advice</strong> on everything from home entertainment to personal tech. <strong>Euronics, a human touch in a digital world.</strong></p>",
          "button_text": "",
          "button_link": "shopify://collections/all"
        }
      },
